# AWS Configuration
# Credentials from AWS Console → Security credentials → Access keys
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# DynamoDB
DYNAMODB_TABLE_NAME=TreatsAI

# Development mode — set to true to use mock AWS services locally
# Set to false when using real AWS credentials
MOCK_AWS=true